# Copy to ./skinet.env (or ~/.config/skinet/skinet.env), then edit.
# Any line can also be overridden by an environment variable of the same name.
# See the resolved values any time with:  skinet where

# --- shared, read-only, called by absolute path -----------------------------
# Leave SKINET_SCRIPTS_DIR commented to use the scripts BUNDLED in the package
# (recommended; includes the fast stitch). Only set it to override with an
# external scripts dir (e.g. a live repo) -- that dir's code then takes over.
#SKINET_SCRIPTS_DIR="/work/lead/mk657917/SKINET/scripts/10_e7_clinical_pipeline"
SKINET_CONDA_SH="/work/lead/mk657917/miniconda3/etc/profile.d/conda.sh"
SKINET_CONDA_ENV="skinet"
SKINET_M2F_LIB="/work/lead/mk657917/skinet/models/Mask2Former"
SKINET_SAM_LIB="/work/lead/mk657917/skinet/models/SAM-Med2D"
SKINET_MODULES="gcc/11.2.0 cuda/11.8"
SKINET_WEIGHTS="/work/lead/mk657917/SKINET/outputs/e7_clinical_pipeline/main_m2f_swin_b/checkpoints/model_best.pth"
SKINET_SPLIT_CSV="/work/lead/mk657917/SKINET/outputs/preprocessing/e7_clinical_pipeline/02_e7_source_split.csv"

# optional, only used with --sam
#SKINET_SAM_BEST="/work/lead/mk657917/SKINET/outputs/e7_clinical_pipeline/sam_kidney_adapter/E7_roicrop_256/checkpoints/best_model.pth"
#SKINET_SAM_CKPT="/work/lead/mk657917/skinet/pretrained/sam_med2d_b.pth"

# --- yours, writable (per-user folder under /work; $USER auto-expands) -------
#SKINET_WORKDIR="/work/lead/$USER/skinet-runs"

# --- cluster -----------------------------------------------------------------
SKINET_QUEUE="gpu"
